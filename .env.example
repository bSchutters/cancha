# --- Cup Generator: required to run ---

# Payload secret (generate a long random string, e.g. `openssl rand -base64 32`)
PAYLOAD_SECRET=

# Postgres connection string (a NEW database, separate from any other project)
DATABASE_URI=postgresql://user:password@host:6543/postgres

# Vercel Blob (media/logo uploads) — create a new store, paste its RW token
BLOB_READ_WRITE_TOKEN=

# Transactional email (registration confirmations) via Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Platform owner: the single super-admin who can see/use the dev mode
OWNER_EMAIL=

# --- Live demo (optional) -----------------------------------------------------
# Publishes working credentials and an open reset endpoint: enable ONLY on a
# deployment meant to be a public demo, never on a client instance.
DEMO_ENABLED=
# Optional overrides; sensible public defaults are used when unset.
DEMO_EMAIL=
DEMO_PASSWORD=

# Secret for the manual cache-purge endpoint (/api/revalidate). Unset = disabled.
REVALIDATE_SECRET=
